docker/redis/data/
docker/n8n/data/
docker/caddy/data/
docker/caddy/config/
docker/minio/data/
test_audio/
source_downloads/
media_temp/

# ──── Logs & Temporary Files ────
*.log
logs/
tmp/
temp/
/tmp/

# ──── IDE & Editor Files ────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ──── OS Artifacts ────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

