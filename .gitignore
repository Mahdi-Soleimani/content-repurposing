# ──── Environment & Secrets ────
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
!.env.example
*.pem
*.key
*.crt
*cookies*.txt
secrets/

# ──── Python ────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!services/web/src/lib/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/

# ──── Node & Next.js ────
node_modules/
.next/
out/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.turbo/

# ──── AI Models & Heavy Weights (>100MB) ────
