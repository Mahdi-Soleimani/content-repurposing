# Content Repurposing Platform — Environment Configuration Example
# Copy this file to .env and replace placeholder values with your real configuration.

# ──── PostgreSQL (Main Application) ────
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=content_repurposing
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://app:changeme_in_production@postgres:5432/content_repurposing

# ──── PostgreSQL (n8n Dedicated Database) ────
N8N_POSTGRES_USER=n8n
N8N_POSTGRES_PASSWORD=changeme_in_production
N8N_POSTGRES_DB=n8n

# ──── Redis ────
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# ──── n8n Workflow Orchestrator ────
N8N_PORT=5678
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme_in_production
N8N_ENCRYPTION_KEY=change-this-encryption-key-in-production
N8N_HOST=localhost
N8N_PROTOCOL=http

# ──── FastAPI Backend ────
API_PORT=8000
API_SECRET_KEY=change-this-secret-key-in-production
API_DEBUG=true
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# ──── Media & Source Workers ────
MEDIA_WORKER_PORT=8001
SOURCE_WORKER_PORT=8002

# ──── Object Storage (MinIO for dev / S3 or ArvanCloud for prod) ────
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=content-repurposing
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000

# ──── n8n Webhooks ────
N8N_WEBHOOK_URL=http://n8n:5678/webhook/71e86bec-459d-4356-9091-091c834c6cfb
N8N_GENERATION_WEBHOOK_URL=http://n8n:5678/webhook/71e86bec-459d-4356-9091-091c834c6cfb

# ──── AI & Transcription Providers ────
# Speech-to-Text: 'shenava' (local on-device ONNX) or 'avalai' / 'openai'
STT_PROVIDER=shenava
SHENAVA_MODEL_PATH=/app/models/shenava-koochik

# Cloud Speech & LLM APIs
OPENAI_API_KEY=sk-your-openai-api-key
AVALAI_API_KEY=aa-your-avalai-api-key
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_STT_MODEL=scribe_v2

# ──── Frontend ────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ──── Caddy Reverse Proxy ────
DOMAIN=localhost
